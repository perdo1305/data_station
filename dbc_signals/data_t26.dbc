CM_ BU_ ICD "Isabellenhuette ISAscale ICD shunt current sensor (datasheet v1.3)";
CM_ BU_ Data_Station "RPi 5 CAN Shield";
CM_ BO_ 1092 "0x444 - INV1 (left) temperatures from HV500 inverter";
CM_ SG_ 1092 INV1_TempInverter "Inverter semiconductor temperature";
CM_ SG_ 1092 INV1_TempMotor "Motor temperature measured by the inverter";
CM_ BO_ 1093 "0x445 - INV2 (right) temperatures from HV500 inverter";
CM_ SG_ 1093 INV2_TempInverter "Inverter semiconductor temperature";
CM_ SG_ 1093 INV2_TempMotor "Motor temperature measured by the inverter";
CM_ BO_ 1282 "Cyclic result frame (default 1 ms in continuous mode). No multiplexer.";
CM_ SG_ 1282 ICD_MsgCounter "Rolling counter 0x0..0xF (high nibble of D0).";
CM_ SG_ 1282 ICD_Current "Signed 32 bit, 1 mA/LSB. Byte order assumed big-endian (Motorola).";
CM_ SG_ 1282 ICD_Ubat "Supply voltage, unsigned 16 bit. 1 mV/LSB (verified on bench; datasheet 0.5 mV figure is resolution, not LSB).";
CM_ BO_ 1280 "Command frame (SET/GET/control), D0 = MUX ID. Get commands carry no payload.";
CM_ SG_ 1280 Req_AccessPw1 "Customer password byte 1 (default 0x30 = '0').";
CM_ BO_ 1281 "Response frame to requests, D0 = response MUX ID. Also carries startup messages (0xE0 x4, 0xE2, 0xE1).";
CM_ SG_ 1281 Resp_AhCounter "Ampere-hour counter in mAs (divide by 3.6e6 for Ah).";
CM_ SG_ 1281 Resp_DevId_Frame "Device ID is a 4-frame multiframe response (counter 0..3), ASCII chars e.g. ICD-A-0100-CAN2-12.";
CM_ SG_ 1281 Resp_HwVer_Frame "HW version is a 2-frame multiframe response (counter 0..1), ASCII chars.";

