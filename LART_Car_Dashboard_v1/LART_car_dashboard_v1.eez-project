        },
        {
          "objID": "102bd5c3-aa27-47b8-fa12-4bf6958eeda8",
          "fileName": "fonts.h",
          "template": "#ifndef EEZ_LVGL_UI_FONTS_H\r\n#define EEZ_LVGL_UI_FONTS_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_FONTS_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_FONTS_H*/"
        },
        {
          "objID": "be0f00df-812e-4ed4-948f-dcb49e636a46",
          "fileName": "styles.h",
          "template": "#ifndef EEZ_LVGL_UI_STYLES_H\r\n#define EEZ_LVGL_UI_STYLES_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_STYLES_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_STYLES_H*/"
        },
        {
          "objID": "6409b27d-bce0-4de0-dc39-00614847d276",
          "fileName": "styles.c",
          "template": "#include \"styles.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n\n//${eez-studio LVGL_STYLES_DEF}\n"
        },
        {
          "objID": "d05c0814-03ab-4c21-cef9-684513ff2adc",
          "fileName": "ui.h",
          "template": "#ifndef EEZ_LVGL_UI_GUI_H\n#define EEZ_LVGL_UI_GUI_H\n\n//${eez-studio LVGL_INCLUDE}\n\n//${eez-studio EEZ_FOR_LVGL_CHECK}\n\n#if defined(EEZ_FOR_LVGL)\n#include <eez/flow/lvgl_api.h>\n#endif\n\n#if !defined(EEZ_FOR_LVGL)\n#include \"screens.h\"\n#endif\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio GUI_ASSETS_DECL}\n\nvoid ui_init();\nvoid ui_tick();\nvoid ui_set_speed(float speed_kph);\nvoid ui_set_screen_var(int screen_id);\nvoid ui_update_telemetry_vars(const void *t);\n\n#if !defined(EEZ_FOR_LVGL)\nvoid loadScreen(enum ScreensEnum screenId);\n#endif\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif // EEZ_LVGL_UI_GUI_H"
        },
        {
          "objID": "084926f1-634e-4671-9fc3-cc34c950eba7",
          "fileName": "ui.c",
          "template": "#if defined(EEZ_FOR_LVGL)\n#include <eez/core/vars.h>\n#endif\n\n#include \"ui.h\"\n#include \"screens.h\"\n#include \"images.h\"\n#include \"actions.h\"\n#include \"vars.h\"\n#include \"stdio.h\"\n\n\n#include \"ros2subscriber.h\"\n#include \"dbc_api.h\"\n\n\n\n//${eez-studio GUI_ASSETS_DEF}\n\n//${eez-studio LVGL_NATIVE_VARS_TABLE_DEF}\n\n//${eez-studio LVGL_ACTIONS_ARRAY_DEF}\n\n#if defined(EEZ_FOR_LVGL)\n\n\nvoid ui_init() {\n    eez_flow_init(assets, sizeof(assets), (lv_obj_t **)&objects, sizeof(objects), images, sizeof(images), actions);\n    \n    if (ros2subscriber_init() != 0) {\n        ui_set_speed(0.0f);\n        return;\n    }\n\n    ui_set_speed(0.0f);\n}\n\n// Screen change names for logging (1-based EEZ-Flow IDs)\nstatic const char *ui_screen_name(int eez_id) {\n    static const char *names[] = { \n        \"?\", \n        \"Driver View\", \n        \"Autonomous\", \n        \"Debug 1\", \n        \"Debug Inverter 2\", \n        \"Debug 3\", \n        \"Debug Wheels 4\", \n        \"Debug 5\", \n        \"Debug Autonomous 1\", \n        \"Debug Autonomous 2\", \n        \"Debug Autonomous 3\", \n        \"Debug Autonomous 4\", \n        \"Debug Autonomous 5\" \n    };\n    if (eez_id >= 1 && eez_id <= 12) return names[eez_id];\n    return \"?\";\n}\n\n// Pending screen change (1-based EEZ-Flow ID, 0 = no pending change).\n// Set by ui_set_screen(), consumed at the top of the next ui_tick()\n// BEFORE eez_flow_tick() runs, preventing state corruption and crashes.\nstatic int g_pending_screen_id = 0;\n\nvoid ui_set_screen(int screen_id);\n\nvoid ui_tick() {\n    // Apply any pending screen change FIRST, before eez_flow_tick().\n    if (g_pending_screen_id != 0) {\n        int16_t current = eez_flow_get_current_screen(); // 1-based\n        int target = g_pending_screen_id;\n        g_pending_screen_id = 0;\n\n        if (target >= _SCREEN_ID_FIRST && target <= _SCREEN_ID_LAST && target != current) {\n            printf(\"[ui_tick] Screen change: %d (%s) -> %d (%s)\\n\",\n                current, ui_screen_name(current),\n                target,  ui_screen_name(target));\n            eez_flow_set_screen((int16_t)target, LV_SCR_LOAD_ANIM_NONE, 0, 0);\n        }\n    }\n\n    // Update speed from ROS\n    float speed_kph;\n    if (ros2subscriber_spin_some() == 0 && ros2subscriber_get_latest_speed(&speed_kph)) {\n        ui_set_speed(speed_kph);\n    }\n\n    // Automatically transition to autonomous screen on ASMS rising edge (0 -> 1)\n    static float prev_asms = -1.0f;\n    float current_asms = dbc_api.acu.asms;\n    if (current_asms == 1.0f && prev_asms != 1.0f) {\n        ui_set_screen(1); // 1 is Autonomous screen (0-based ROS2 screen ID)\n    }\n    prev_asms = current_asms;\n\n    eez_flow_tick();\n    tick_screen(g_currentScreen);\n\n    // Queue any screen change request received this tick.\n    // It will be applied at the top of the NEXT tick, before eez_flow_tick().\n    int screen_id;\n    if (ros2subscriber_get_screen_change_request(&screen_id)) {\n        ui_set_screen(screen_id);\n    }\n}\n\nvoid ui_setup_timers(void) {\n    // No LVGL timers required for ROS2 subscriber mode.\n}\n\n// Cleanup on shutdown\nvoid ui_fini(void) {\n    ros2subscriber_fini();\n}\n\n// Request a screen change by ROS2 0-based ID (0=Driver View, 1=Autonomous, 2-6=Debug 1-5, 7-11=Debug Autonomous 1-5).\n// Converts to EEZ-Flow's 1-based ID and queues it for the next tick.\nvoid ui_set_screen(int screen_id) {\n    if (screen_id >= 0 && screen_id <= 11) {\n        g_pending_screen_id = screen_id + 1; // 0-based -> 1-based EEZ-Flow ID\n        printf(\"[ui_set_screen] Queued screen: ROS2 id=%d (%s) -> eez_id=%d\\n\",\n               screen_id, ui_screen_name(screen_id + 1), screen_id + 1);\n    } else {\n        printf(\"[ui_set_screen] Ignoring invalid screen_id: %d\\n\", screen_id);\n    }\n}\n\n#endif\n"
        }
      ],
      "destinationFolder": "src\\ui",
      "separateFolderForImagesAndFonts": true,
      "imageExportMode": "source",
      "fontExportMode": "source",
      "fileSystemPath": "",
      "lvglInclude": "lvgl.h",
      "screensLifetimeSupport": false,
      "useDockerDesktop": true,
      "generateSourceCodeForEezFramework": true,
      "compressFlowDefinition": false,
      "executionQueueSize": 1000,
      "expressionEvaluatorStackSize": 20
    }
